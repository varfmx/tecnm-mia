%% ------------------- DATOS FIJOS (edítalos una sola vez) -------------
\newcommand{\Maestria}{Maestría en Inteligencia Artificial}
\newcommand{\Alumno}{Fernando Valderrábano Reyes}
\newcommand{\NumControl}{26381113}   % deja {} para omitirlo
\newcommand{\Lugar}{Cabo San Lucas, B.C.S.}
\newcommand{\Fecha}{\today}                % o una fecha fija
\newcommand{\Institucion}{Instituto Tecnológico de Estudios Superiores de Los Cabos}
\newcommand{\ArchivoBib}{referencias.bib}  % ruta desde la raíz del proyecto

%% ------------------- DATOS POR ACTIVIDAD (se definen en actN.tex) ----
\newcommand{\Materia}{Nombre de la materia}
\newcommand{\Actividad}{Título de la actividad}
\newcommand{\Profesor}{Nombre del profesor}
\newcommand{\materia}[1]{\renewcommand{\Materia}{#1}}
\newcommand{\actividad}[1]{\renewcommand{\Actividad}{#1}}
\newcommand{\profesor}[1]{\renewcommand{\Profesor}{#1}}
\newcommand{\fecha}[1]{\renewcommand{\Fecha}{#1}}

%% ------------------- OPCIONES: indice / sinindice --------------------
\newif\if@tecnm@indice
\@tecnm@indicetrue
\DeclareOption{indice}{\@tecnm@indicetrue}
\DeclareOption{sinindice}{\@tecnm@indicefalse}
\ProcessOptions\relax

%% ------------------- PAQUETES ----------------------------------------
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[spanish,es-noshorthands,es-tabla]{babel}
\RequirePackage[scaled=.92]{helvet}      % Arial-compatible (Nimbus Sans)
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage[margin=2.5cm]{geometry}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{setspace}
\RequirePackage{titlesec}
\RequirePackage{csquotes}
\RequirePackage{hyperref}
\RequirePackage[backend=biber,style=apa]{biblatex}
\DeclareLanguageMapping{spanish}{spanish-apa}
\AtEndPreamble{\addbibresource{\ArchivoBib}}

\definecolor{tecnmazul}{HTML}{1B3A6B}
\AtBeginDocument{%
  \hypersetup{colorlinks=false,linkcolor=tecnmazul,citecolor=tecnmazul,
    urlcolor=tecnmazul,hypertexnames=false,
    pdfborder={0 0 0},
    pdftitle={\Actividad},pdfauthor={\Alumno}}}

\setstretch{1.15}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.6em}

%% Títulos de sección: más grandes que el texto (11 pt)
\titleformat{\section}{\fontsize{14}{17}\selectfont\bfseries\color{tecnmazul}}{\thesection}{0.6em}{}
\titleformat{\subsection}{\fontsize{12.5}{15}\selectfont\bfseries\color{tecnmazul}}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\fontsize{11.5}{14}\selectfont\bfseries\color{tecnmazul}}{\thesubsubsection}{0.6em}{}

